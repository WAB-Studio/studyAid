# Entorno
.venv/
__pycache__/
*.py[cod]

# Estado transitorio de la sesión en curso: se reconstruye o se descarta,
# no tiene sentido versionarlo y cambia varias veces por sesión.
data/current_session.json
*.tmp

# Los datos de estudio SÍ se versionan desde el 2026-09-21, por decisión suya.
# La regla anterior los ignoraba, pero se había escrito para no arrastrar los datos de
# otra persona, no para esconder los de él. Esta rama es la suya y es la línea real.
# Perfil, línea base, temas, bitácoras, tarjetas y sesiones van al repo.

# Material descargado: puede ser pesado y no es nuestro.
# El índice de qué se consultó vive en base/fuentes.md, que sí se versiona.
fuentes/*
!fuentes/.gitkeep

# Permisos locales de la máquina
.claude/settings.local.json

# Ruido de editores y sistema
.DS_Store
*.swp
.idea/
.vscode/
